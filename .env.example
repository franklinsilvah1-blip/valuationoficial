# Frontend (Vite) — variáveis públicas do Supabase
VITE_SUPABASE_URL=
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=

# ---------------------------------------------------------------------------
# As variáveis abaixo são usadas pelas Supabase Edge Functions
# (supabase/functions/*), configuradas via `supabase secrets set` ou no
# dashboard do projeto — NÃO pertencem a este arquivo .env do frontend.
# Listadas aqui apenas como referência de nomes, sem valores.
# ---------------------------------------------------------------------------

# Stripe — NOVOS price IDs para o modelo de 4 planos (START/PRO/SPECIALIST/WEALTH)
# PRO e SPECIALIST agora têm cobrança mensal e trimestral. Estas variáveis
# ainda não estão configuradas em produção — create-checkout falha de forma
# clara (erro explícito, sem escolher um plano incorreto) enquanto isso.
# Ver supabase/functions/_shared/planResolution.ts.
STRIPE_PRICE_PRO_MONTHLY=
STRIPE_PRICE_PRO_QUARTERLY=
STRIPE_PRICE_SPECIALIST_MONTHLY=
STRIPE_PRICE_SPECIALIST_QUARTERLY=

# Stripe — já existentes (não alterados nesta migração)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_START=
STRIPE_PRICE_PRO=
STRIPE_PRICE_SPECIALIST=

# Demais integrações (sem relação com esta migração de planos, listadas por completude)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
RESEND_API_KEY=
TURNSTILE_SECRET_KEY=
CRON_SECRET=
GITHUB_BACKUP_TOKEN=
GITHUB_BACKUP_REPO=
GOOGLE_SHEETS_API_KEY=
GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=
GOOGLE_SHEETS_RANGE=
SMTP_ENCRYPTION_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
